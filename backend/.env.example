# PostgreSQL
DATABASE_URL=postgresql://fitpulse:fitpulse@localhost:5432/fitpulse

# Auth (use 32+ characters in production)
JWT_SECRET=dev-only-fitpulse-jwt-secret-change-me!!

# Comma-separated browser origins
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Email — Gmail SMTP (fitpulsesaas@gmail.com)
# 1) Enable 2-Step Verification on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Put that 16-character password in SMTP_PASS (not the normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fitpulsesaas@gmail.com
SMTP_PASS=
MAIL_FROM=FitPulse <fitpulsesaas@gmail.com>

# Alternative: Resend (https://resend.com) — takes priority over SMTP if set
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=FitPulse <beth.t@example.com>

PORT=4000
NODE_ENV=development
SEED_ON_START=true
